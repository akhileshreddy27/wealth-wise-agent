# Copy this file to .env and fill in what you need. Everything is optional.

# Free Gemini key: https://aistudio.google.com/apikey
# Without it the app still works; AI features fall back to rule-based answers and keyword search.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite   (used when the main model is busy)
# EMBEDDING_MODEL=gemini-embedding-001

# RISK_FREE_RATE=0.065
# CORS_ORIGINS=http://localhost:5173
